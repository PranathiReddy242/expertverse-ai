{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/auth/(.*)", "destination": "/api/index.py" },
    { "source": "/experts/list", "destination": "/api/index.py" },
    { "source": "/experts/search", "destination": "/api/index.py" },
    { "source": "/experts/featured", "destination": "/api/index.py" },
    { "source": "/experts/profile", "destination": "/api/index.py" },
    { "source": "/bookings/(.*)", "destination": "/api/index.py" },
    { "source": "/agents/(.*)", "destination": "/api/index.py" },
    { "source": "/documents/(.*)", "destination": "/api/index.py" },
    { "source": "/admin/(.*)", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/((?!api|auth|experts/list|experts/search|experts/featured|experts/profile|bookings|agents|documents|admin|health).*)", "destination": "/index.html" }
  ]
}
